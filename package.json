{
  "name": "@kingironman2011/vite-pages",
  "version": "1.1.0",
  "description": "Vite plugin that auto-generates HTML files for every react-router-dom route so refreshing on a sub-page never 404s (great for GitHub Pages, Netlify, Vercel static, etc.)",
  "keywords": [
    "404",
    "github-pages",
    "html-generation",
    "react-router",
    "react-router-dom",
    "spa",
    "static",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/KingIronMan2011/vite-pages#readme",
  "bugs": {
    "url": "https://github.com/KingIronMan2011/vite-pages/issues"
  },
  "license": "MIT",
  "author": "KingIronMan2011",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KingIronMan2011/vite-pages.git"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "peerDependencies": {
    "vite": ">=7.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0"
}
